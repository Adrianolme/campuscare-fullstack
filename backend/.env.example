# Copia este archivo como ".env" y ajusta los valores
PORT=3000

# Motor de base de datos: mysql (por defecto) o sqlite (solo pruebas, Node >= 22.13)
DB_CLIENT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_contraseña_aqui
DB_NAME=campuscare
SQLITE_FILE=./database/campuscare.sqlite

# Origen del front permitido por CORS (ej. https://TUUSUARIO.github.io). "*" = cualquiera
CORS_ORIGIN=*

# Si es "no", el backend NO sirve la carpeta ../campuscare-web
SERVIR_FRONTEND=si
